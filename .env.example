# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# WhatsApp Service URL (backend)
# Change this to your production URL when deploying
VITE_WHATSAPP_SERVICE_URL="http://localhost:3001"
APP_URL="http://localhost:3000"

# CEP lookup runs through the WhatsApp/backend service.
# Set CEP_FREE_PROVIDER=viacep or brasilapi in whatsapp-service/.env

# WhatsApp Cloud API (Official Business API)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v22.0"

# MinIO/S3 para midias recebidas no WhatsApp (imagens, docs, PDFs e audios)
MINIO_ENDPOINT="n.woopanel.com.br"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="woogabinete"
MINIO_USE_SSL="true"
MINIO_PUBLIC_URL="https://n.woopanel.com.br/woogabinete"
