# Railway / WhatsApp Service
# Preencha as variáveis abaixo via Railway dashboard ou CLI secrets

PORT="8080"
APP_URL="https://gabinete.consultio.com.br"
ALLOWED_ORIGINS="https://gabinete.consultio.com.br,https://meugabinete-production.up.railway.app,http://localhost:3000,http://localhost:3003"

# Database - use DATABASE_URL do Railway PostgreSQL plugin ou configure manualmente
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Supabase
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_BUCKET="meugabinete"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Use o JWT Secret do Supabase em Project Settings > API > JWT Secret
JWT_SECRET="seu-jwt-secret"

# AI
AI_PROVIDER="gemini"
GEMINI_API_KEY="sua-gemini-api-key"
