# Configurações de Produção - WhatsApp Service

# Porta do serviço
PORT=8080

# URL do Banco de Dados (PostgreSQL recomendado para produção)
# Formato: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:password@db.example.com:5432/postgres

# Supabase REST/Storage usados pelo processamento de mensagens
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_BUCKET=meugabinete

# MinIO/S3 para arquivos de midia do WhatsApp.
# Configure as credenciais reais no ambiente do servidor/Portainer.
MINIO_ENDPOINT=n.woopanel.com.br
MINIO_ACCESS_KEY=sua-access-key-minio
MINIO_SECRET_KEY=sua-secret-key-minio
MINIO_BUCKET=woogabinete
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://n.woopanel.com.br/woogabinete

# Chave Secreta JWT (DEVE ser a mesma do Supabase > Project Settings > API > JWT Secret)
JWT_SECRET=sua-chave-secreta-do-supabase-aqui

# Origens permitidas para CORS (URL do seu frontend)
ALLOWED_ORIGINS=https://woogabinete.consultio.com.br,http://localhost:3000,http://localhost:3003

# Consulta gratuita de CEP: viacep (padrao) ou brasilapi
CEP_FREE_PROVIDER=viacep

# URL pública do frontend
APP_URL=https://woogabinete.consultio.com.br

# Provedores de IA (Opcional)
AI_PROVIDER=gemini
GOOGLE_API_KEY=sua-chave-google-aqui
GEMINI_API_KEY=sua-chave-gemini-aqui
OPENAI_API_KEY=sua-chave-openai-aqui
GROQ_API_KEY=sua-chave-groq-aqui
